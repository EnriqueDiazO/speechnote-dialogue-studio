{
  "schema_version": 1,
  "language": "es",
  "category": "mathematics",
  "rules": [
    {"kind": "math_alias", "patterns": ["α", "Α", "\\alpha"], "replacement": "alfa", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["β", "Β", "\\beta"], "replacement": "beta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["γ", "Γ", "\\gamma", "\\Gamma"], "replacement": "gamma", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["δ", "Δ", "\\delta"], "replacement": "delta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ε", "Ε", "\\epsilon"], "replacement": "épsilon", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["η", "Η", "\\eta"], "replacement": "eta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ϵ", "\\varepsilon"], "replacement": "épsilon variante", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["θ", "Θ", "\\theta"], "replacement": "theta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ϑ", "\\vartheta"], "replacement": "theta variante", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["λ", "Λ", "\\lambda"], "replacement": "lambda", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["μ", "Μ", "\\mu"], "replacement": "mu", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["π", "Π", "\\pi"], "replacement": "pi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ρ", "Ρ", "\\rho"], "replacement": "ro", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["σ", "Σ", "\\sigma"], "replacement": "sigma", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["τ", "Τ", "\\tau"], "replacement": "tau", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["φ", "Φ", "\\phi"], "replacement": "fi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ϕ", "\\varphi"], "replacement": "fi variante", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ψ", "Ψ", "\\psi"], "replacement": "psi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ω", "Ω", "\\omega"], "replacement": "omega", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["χ", "Χ", "\\chi"], "replacement": "ji", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["+"], "replacement": "más", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["−", "-"], "replacement": "menos", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["×", "·", "\\times", "\\cdot"], "replacement": "por", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["="], "replacement": "igual a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["\\neq", "≠"], "replacement": "distinto de", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["\\to", "\\rightarrow", "→"], "replacement": "tiende a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["≤", "\\leq"], "replacement": "menor o igual que", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["≥", "\\geq"], "replacement": "mayor o igual que", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∞", "\\infty"], "replacement": "infinito", "whole_word": false, "category": "calculus"},
    {"kind": "math_alias", "patterns": ["∇", "\\nabla"], "replacement": "gradiente", "whole_word": false, "category": "calculus"},
    {"kind": "math_alias", "patterns": ["∂", "\\partial"], "replacement": "derivada parcial", "whole_word": false, "category": "calculus"},
    {"kind": "math_alias", "patterns": ["∈", "\\in"], "replacement": "pertenece a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∉", "\\notin"], "replacement": "no pertenece a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∅", "\\emptyset"], "replacement": "conjunto vacío", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["<", "\\lt"], "replacement": "menor que", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": [">", "\\gt"], "replacement": "mayor que", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["≈", "\\approx"], "replacement": "aproximadamente igual a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∼", "\\sim"], "replacement": "similar a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["±", "\\pm"], "replacement": "más o menos", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∓", "\\mp"], "replacement": "menos o más", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∝", "\\propto"], "replacement": "proporcional a", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["↦", "\\mapsto"], "replacement": "se transforma en", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["⊂", "\\subset"], "replacement": "es subconjunto de", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["⊆", "\\subseteq"], "replacement": "es subconjunto o igual a", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["∪", "\\cup"], "replacement": "unión", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["∩", "\\cap"], "replacement": "intersección", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "pattern": "\\mid", "replacement": "dado", "whole_word": false, "category": "probability"},
    {"kind": "math_alias", "pattern": "E", "replacement": "esperanza", "category": "statistics"},
    {"kind": "math_alias", "pattern": "Var", "replacement": "varianza", "category": "statistics"},
    {"kind": "math_alias", "pattern": "Cov", "replacement": "covarianza", "category": "statistics"},
    {"kind": "math_alias", "pattern": "P", "replacement": "probabilidad", "category": "probability"}
  ]
}
