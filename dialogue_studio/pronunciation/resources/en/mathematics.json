{
  "schema_version": 1,
  "language": "en",
  "category": "mathematics",
  "rules": [
    {"kind": "math_alias", "patterns": ["α", "Α", "\\alpha"], "replacement": "alpha", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["β", "Β", "\\beta"], "replacement": "beta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["γ", "Γ", "\\gamma"], "replacement": "gamma", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["δ", "Δ", "\\delta"], "replacement": "delta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ε", "Ε", "\\epsilon"], "replacement": "epsilon", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["η", "Η", "\\eta"], "replacement": "eta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ϵ", "\\varepsilon"], "replacement": "variant epsilon", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["θ", "Θ", "\\theta"], "replacement": "theta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ϑ", "\\vartheta"], "replacement": "variant theta", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["λ", "Λ", "\\lambda"], "replacement": "lambda", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["μ", "Μ", "\\mu"], "replacement": "mu", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["π", "Π", "\\pi"], "replacement": "pi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ρ", "Ρ", "\\rho"], "replacement": "rho", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["σ", "Σ", "\\sigma"], "replacement": "sigma", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["τ", "Τ", "\\tau"], "replacement": "tau", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["φ", "Φ", "\\phi"], "replacement": "phi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ϕ", "\\varphi"], "replacement": "variant phi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ψ", "Ψ", "\\psi"], "replacement": "psi", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["ω", "Ω", "\\omega"], "replacement": "omega", "whole_word": false, "category": "greek"},
    {"kind": "math_alias", "patterns": ["+"], "replacement": "plus", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["−", "-"], "replacement": "minus", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["×", "·"], "replacement": "times", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["="], "replacement": "equals", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["\\neq", "≠"], "replacement": "not equal to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["\\to", "\\rightarrow", "→"], "replacement": "approaches", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["≤", "\\leq"], "replacement": "less than or equal to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["≥", "\\geq"], "replacement": "greater than or equal to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∞", "\\infty"], "replacement": "infinity", "whole_word": false, "category": "calculus"},
    {"kind": "math_alias", "patterns": ["∇", "\\nabla"], "replacement": "gradient", "whole_word": false, "category": "calculus"},
    {"kind": "math_alias", "patterns": ["∂", "\\partial"], "replacement": "partial derivative", "whole_word": false, "category": "calculus"},
    {"kind": "math_alias", "patterns": ["∈", "\\in"], "replacement": "belongs to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∉", "\\notin"], "replacement": "does not belong to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∅", "\\emptyset"], "replacement": "empty set", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["<", "\\lt"], "replacement": "less than", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": [">", "\\gt"], "replacement": "greater than", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["≈", "\\approx"], "replacement": "approximately equal to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∼", "\\sim"], "replacement": "similar to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["±", "\\pm"], "replacement": "plus or minus", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∓", "\\mp"], "replacement": "minus or plus", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["∝", "\\propto"], "replacement": "proportional to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["↦", "\\mapsto"], "replacement": "maps to", "whole_word": false, "category": "operator"},
    {"kind": "math_alias", "patterns": ["⊂", "\\subset"], "replacement": "is a subset of", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["⊆", "\\subseteq"], "replacement": "is a subset of or equal to", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["∪", "\\cup"], "replacement": "union", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "patterns": ["∩", "\\cap"], "replacement": "intersection", "whole_word": false, "category": "set_theory"},
    {"kind": "math_alias", "pattern": "E", "replacement": "expectation", "category": "statistics"},
    {"kind": "math_alias", "pattern": "Var", "replacement": "variance", "category": "statistics"},
    {"kind": "math_alias", "pattern": "Cov", "replacement": "covariance", "category": "statistics"},
    {"kind": "math_alias", "pattern": "P", "replacement": "probability", "category": "probability"}
  ]
}
